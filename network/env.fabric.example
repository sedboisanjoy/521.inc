# Backend env for LEDGER_MODE=fabric, pointing at the Fabric test-network's
# Org1 (mapped to BMET). Copy the values below when launching the backend:
#
#   set -a && source network/env.fabric.example && set +a && (cd backend && go run .)
#
# Paths assume the default fabric-samples/test-network crypto layout.

LEDGER_MODE=fabric
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_GATEWAY_PEER=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=anchor-channel
FABRIC_CHAINCODE=employment-passport

# Crypto material (edit HOME/path if fabric-samples lives elsewhere)
FABRIC_TLS_CERT=${HOME}/hyperledger/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_USER_CERT=${HOME}/hyperledger/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_USER_KEY_DIR=${HOME}/hyperledger/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore
